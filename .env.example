KAT_DATA_DIR=./data

# Organizer Token Factory model. Cloud CLI login is separate.
SUPER_BASE_URL=https://api.tokenfactory.nebius.com/v1
SUPER_MODEL=nvidia/Nemotron-3.5-Super-VL
SUPER_API_KEY=

# Shared Parse 3.5. No participant key required.
PARSE_BASE_URL=https://port8000-kh2kceraevwe0k1.tunnel.applications.uk-south2.nebius.cloud/v1
PARSE_MODEL=nvidia/nemotron-3.5-parse
PARSE_API_KEY=

# Shared pre-indexed Wikipedia service, sanctioned by participant brief.
WIKIPEDIA_MODE=shared
WIKIPEDIA_API_URL=https://port8000-rks0xavparpzq59.tunnel.applications.uk-south2.nebius.cloud

# Deploy the official ONE-image embed/rerank recipe on a Nebius GPU VM.
# Forward the VM port to localhost8000, then set this URL.
RETRIEVAL_BASE_URL=
RETRIEVAL_API_KEY=
RETRIEVAL_IMAGE=
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
EMBED_PROTOCOL=challenge
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
RERANK_PROTOCOL=challenge

# Hermes uses its isolated Python3.14 environment. See docs/hermes.md.
HERMES_REPO_PATH=
HERMES_PYTHON=
LATEX_ENGINE=tectonic
KAT_HTTP_TIMEOUT=180
KAT_FETCH_CANDIDATES=6
